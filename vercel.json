{
  "version": 2,
  "builds": [
    {
      "src": "server/server-supabase.js",
      "use": "@vercel/node"
    },
    {
      "src": "admin/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/server-supabase.js"
    },
    {
      "src": "/css/(.*)",
      "dest": "/admin/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/admin/js/$1"
    },
    {
      "src": "/dashboard.html",
      "dest": "/admin/dashboard.html"
    },
    {
      "src": "/dashboard",
      "dest": "/admin/dashboard.html"
    },
    {
      "src": "/settings.html",
      "dest": "/admin/settings.html"
    },
    {
      "src": "/settings",
      "dest": "/admin/settings.html"
    },
    {
      "src": "/",
      "dest": "/admin/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/admin/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
