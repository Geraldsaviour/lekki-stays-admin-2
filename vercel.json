{
  "version": 2,
  "name": "lekki-stays-admin",
  "builds": [
    {
      "src": "server/server-supabase.js",
      "use": "@vercel/node"
    },
    {
      "src": "admin/**",
      "use": "@vercel/static",
      "config": { "cleanUrls": false }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/server-supabase.js"
    },
    {
      "src": "/css/(.*)",
      "dest": "/admin/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/admin/js/$1"
    },
    {
      "src": "/dashboard.html",
      "dest": "/admin/dashboard.html"
    },
    {
      "src": "/dashboard",
      "dest": "/admin/dashboard.html"
    },
    {
      "src": "/settings.html",
      "dest": "/admin/settings.html"
    },
    {
      "src": "/settings",
      "dest": "/admin/settings.html"
    },
    {
      "src": "/",
      "dest": "/admin/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/admin/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cancel-expired-bookings",
      "schedule": "0 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/dashboard.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
